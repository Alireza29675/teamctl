# product-team: environment variables
#
# Copy to .env and fill in. Load with: `set -a; . ./.env; set +a`.
#
# Two Telegram bots — one per human-facing manager. You hold two
# conversations: the product one with the Product Manager, the delivery one with the
# Engineering Manager. The engineers run headless (no bot of their own); their work
# reaches you through the Engineering Manager.
#
# Create each bot via @BotFather and paste its token below. Find your
# chat id with @userinfobot. `teamctl bot setup` can fill these in for
# you interactively.

# ─── Product Manager bot (the *what*: product discovery, requirements) ───────────
TEAMCTL_TG_PM_TOKEN="123456:AAH-pm-bot-token"
TEAMCTL_TG_PM_CHATS="123456789"

# ─── Engineering Manager bot (the *how*: delivery, shippable increments, gates) ──────
TEAMCTL_TG_EM_TOKEN="123456:AAH-em-bot-token"
TEAMCTL_TG_EM_CHATS="123456789"
