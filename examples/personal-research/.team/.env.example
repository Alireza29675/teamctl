# Telegram bot for buddy. get the token from @BotFather and the chat id
# from @userinfobot (or `/start` against your fresh bot).
TEAMCTL_TG_BUDDY_TOKEN=
TEAMCTL_TG_BUDDY_CHATS=

# Search/news MCP for the curator (Brave Search). Free tier at
# https://brave.com/search/api/ . Or swap the `search` MCP in
# projects/research.yaml for any search/news server and change this key.
BRAVE_API_KEY=
