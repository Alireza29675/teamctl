# Telegram bot for lead. Get the token from @BotFather and the chat id
# from @userinfobot (or `/start` against your fresh bot).
TEAMCTL_TG_LEAD_TOKEN=
TEAMCTL_TG_LEAD_CHATS=

# Optional: scout's live jobs-API feed. The job-board MCP is commented out
# in projects/jobs.yaml by default — scout's board-sweeper sub-agent works
# without it (it sweeps public boards over the web). If you wire the Adzuna
# community MCP, grab free keys at developer.adzuna.com and set them here:
# ADZUNA_APP_ID=
# ADZUNA_APP_KEY=
