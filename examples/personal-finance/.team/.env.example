# Telegram bot for books. Get the token from @BotFather and the chat id
# from @userinfobot (or `/start` against your fresh bot).
TEAMCTL_TG_BOOKS_TOKEN=
TEAMCTL_TG_BOOKS_CHATS=

# tracker's financial-data feed is Plaid's official MCP (mcp-server-plaid),
# wired in projects/finance.yaml. Out of the box it runs against Plaid's
# free SANDBOX: make a free account at dashboard.plaid.com and paste your
# Sandbox client_id / secret below. Leave them blank and the team still
# comes up — tracker just won't have a live feed. For real account data,
# use your production Plaid credentials instead. The team is read-only by
# design; nothing moves money without your tap.
PLAID_CLIENT_ID=
PLAID_SECRET=
