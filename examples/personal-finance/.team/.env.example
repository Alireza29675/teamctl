# Telegram bot for books. Get the token from @BotFather and the chat id
# from @userinfobot (or `/start` against your fresh bot).
TEAMCTL_TG_BOOKS_TOKEN=
TEAMCTL_TG_BOOKS_CHATS=

# Optional: if your tracker pulls from a financial-data aggregator
# (Plaid, Teller, etc.), drop the credentials here. The team is
# read-only by design; nothing moves money without your tap.
# PLAID_CLIENT_ID=
# PLAID_SECRET=
