# Builder agent (ops project) — Telegram interface.
#
# 1. Create a bot at @BotFather and copy the token below.
# 2. Get your Telegram chat id from @userinfobot (or any other id bot).
# 3. Fill in the two values, save this file as `.env`, and run
#    `teamctl up`. Message the builder bot to start building your team.

TEAMCTL_TG_BUILDER_TOKEN=
TEAMCTL_TG_BUILDER_CHATS=
