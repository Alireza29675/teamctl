# ── Ideate & Build team secrets ────────────────────────────────────────────
#
# Copy this file to `.env` and fill in the values. `.env` is gitignored.
# `teamctl up` loads it automatically.

# Executor's Telegram bot token (from @BotFather). The Executor runs the team
# and is your main point of contact.
TEAMCTL_TG_EXECUTOR_TOKEN=

# Telegram chat IDs allowed to talk to the Executor (comma-separated).
# Send a message to your bot, then check `teamctl status` to find your chat ID.
TEAMCTL_TG_EXECUTOR_CHATS=

# Compass's Telegram bot token (from @BotFather). Compass is your private
# upstream ideation partner — use a SEPARATE bot from the Executor.
TEAMCTL_TG_COMPASS_TOKEN=

# Telegram chat IDs allowed to talk to Compass (comma-separated).
TEAMCTL_TG_COMPASS_CHATS=
