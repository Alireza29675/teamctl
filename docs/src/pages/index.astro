---
// Landing page with README parity (README is the source of truth). Hero +
// lede + intro + install + start-a-team + extras + examples + what-a-team +
// teamctl ui + learn-more. Linear-tier layout, Vercel-tier code container,
// no animation. Strict accent rule: YAML keys + Copy hover only.

import { Picture, Image } from 'astro:assets';
import heroPng from '../../assets/hero.png';
import uiSplash from '../../assets/ui/splash.png';
import uiControlRoom from '../../assets/ui/control-room.png';
import uiAgentDetail from '../../assets/ui/agent-detail.png';
import uiTypeIntoPane from '../../assets/ui/type-into-pane.png';

const installCmd = 'curl -fsSL https://teamctl.run/install | sh';
const initCmd = 'teamctl init';

// Sample team YAML for the demo. Mirrors the README's "What a team looks
// like" section verbatim: product-team with a service-desk manager, two
// executors (Claude + Codex) in a review loop, and a research worker.
const yaml = [
  'version: 2',
  '',
  'project:',
  '  id: product-team',
  '',
  '# 📡 Slack-like channels: agents in a channel can post messages and receive notifications',
  'channels:',
  '  - name: all',
  '    members: "*"',
  '',
  '  - name: code_review         # 🔀 so the executors can ask each other to review each other\'s PRs',
  '    members: [claude_exec, codex_exec]',
  '',
  'managers:',
  '  # 🛎️ your one manager: you chat with it on Telegram, it runs the show',
  '  service_desk:',
  '    display_name: "Service Desk"',
  '    runtime: claude-code',
  '    model: claude-sonnet-4-6',
  '    role_prompt:               # 🧬 cascading roles: _base.md layers into every agent',
  '      - roles/_base.md',
  '      - roles/service_desk.md',
  '    interfaces:',
  '      telegram:               # 📱 tap to talk to your team from your phone',
  '        bot_token_env: TEAMCTL_TG_TOKEN',
  '        chat_ids_env: TEAMCTL_TG_CHATS',
  '',
  'workers:',
  '  # 🤖 a Claude executor: ships work and reviews the Codex executor\'s PRs',
  '  claude_exec:',
  '    display_name: "Executor (Claude)"',
  '    runtime: claude-code',
  '    model: claude-opus-4-8',
  '    role_prompt:',
  '      - roles/_base.md',
  '      - roles/_engineer.md     # 🧬 group layer shared by the engineers',
  '      - roles/executor.md',
  '    reports_to: service_desk',
  '    subagents:                # 🧩 give an agent its own sub-agents (claude-code)',
  '      - agents/researcher.md',
  '',
  '  # 🤖 a Codex executor: the other half of the review loop',
  '  codex_exec:',
  '    display_name: "Executor (Codex)"',
  '    runtime: codex',
  '    model: gpt-5-codex',
  '    role_prompt:',
  '      - roles/_base.md',
  '      - roles/_engineer.md',
  '      - roles/executor.md',
  '    reports_to: service_desk',
  '',
  '  # 🔭 autonomous discovery: keeps finding and prototyping ideas',
  '  research:',
  '    display_name: "Research and Discovery"',
  '    runtime: claude-code',
  '    model: claude-opus-4-8',
  '    role_prompt:',
  '      - roles/_base.md',
  '      - roles/research.md',
  '    reports_to: service_desk',
  '    subagents:',
  '      - agents/researcher.md',
  '      - agents/code_search.md',
];

// Render each YAML line server-side as muted-2-tone HTML. Keys carry
// the accent token; everything else is base --fg.
const escape = (s: string) =>
  s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
const yamlHtml = yaml
  .map((raw) => {
    if (raw === '') return '';
    const m = /^(\s*)([A-Za-z_][\w-]*)(:.*)$/.exec(raw);
    if (!m) return escape(raw);
    const [, indent, key, rest] = m;
    return `${indent}<span class="k">${escape(key)}:</span>${escape(rest.slice(1))}`;
  })
  .join('\n');

// Examples mirror the README table: same set, same order, same descriptions.
const examples = [
  {
    emoji: '🏗️',
    title: 'product-team',
    href: 'https://github.com/Alireza29675/teamctl/tree/main/examples/product-team',
    what: 'A product squad: a PM and engineers coordinating around what to build and ship.',
  },
  {
    emoji: '🛰️',
    title: 'oss-maintainer',
    href: 'https://github.com/Alireza29675/teamctl/tree/main/examples/oss-maintainer',
    what: 'Runs a one-person open-source project: triage, bug-fix PRs, docs, and release proposals you approve.',
  },
  {
    emoji: '🧪',
    title: 'autonomous-prototyper',
    href: 'https://github.com/Alireza29675/teamctl/tree/main/examples/autonomous-prototyper',
    what: 'Comes up with ideas and prototypes them end to end.',
  },
  {
    emoji: '🌱',
    title: 'personal-research',
    href: 'https://github.com/Alireza29675/teamctl/tree/main/examples/personal-research',
    what: 'A reading buddy that holds your interests, plus a curator that follows the news and surfaces what matters.',
  },
  {
    emoji: '📈',
    title: 'market-analysts',
    href: 'https://github.com/Alireza29675/teamctl/tree/main/examples/market-analysts',
    what: 'A read-only research desk that backs financial decisions, with one analyst whose only job is to dissent.',
  },
  {
    emoji: '💼',
    title: 'job-finder',
    href: 'https://github.com/Alireza29675/teamctl/tree/main/examples/job-finder',
    what: 'Runs your job search: watches boards, aligns your CV to postings, and drafts cover letters you approve.',
  },
];

// "Extras on top" mirrors the README: same six, same framing, same links.
const extras = [
  {
    emoji: '🔀',
    title: 'Orchestration and a shared mailbox',
    href: '/concepts/channels/',
    body: 'agents coordinate and message each other through durable channels you can audit.',
  },
  {
    emoji: '⚙️',
    title: 'Per-agent settings',
    href: '/reference/team-compose-yaml/',
    body: 'give each agent its own runtime, model, role, and tools.',
  },
  {
    emoji: '🧬',
    title: 'Cascading role prompts',
    href: '/reference/team-compose-yaml/',
    body: 'layer a shared `_base.md` and group files like `_engineer.md` under each agent\'s own role, so the rules they share live in one place.',
  },
  {
    emoji: '🖥️',
    title: 'One terminal UI for the whole team',
    href: '/reference/teamctl/',
    body: 'watch every agent in one place with `teamctl ui`.',
  },
  {
    emoji: '📱',
    title: 'Easy Telegram hookup',
    href: '/guides/telegram-bot/',
    body: 'steer your team from your phone (more interfaces on the way).',
  },
  {
    emoji: '⏳',
    title: '(soon) Auto-recovery from rate limits',
    href: null,
    body: 'teamctl can let your session know when its rate limit has cleared so it picks the work back up.',
  },
];

const uiShots = [
  { src: uiSplash, caption: 'Splash screen' },
  { src: uiControlRoom, caption: 'You can view all your teams, their actual sessions, their mailbox' },
  { src: uiAgentDetail, caption: 'You can inspect each message exchanged between agents' },
  { src: uiTypeIntoPane, caption: 'You can also connect to the actual tmux sessions by pressing Ctrl+E and take control of the session' },
];

// Render inline `code` spans in body text.
const withCode = (s: string) =>
  s.replace(/`([^`]+)`/g, '<code>$1</code>');
---
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>teamctl: bottle your agent setup and run it like a recipe</title>
    <meta
      name="description"
      content="You configure the perfect Claude Code or Codex session, then it dies with the session. teamctl lets you bottle your whole agent setup as something you can run, share, and remix like a recipe."
    />
    <meta property="og:title" content="teamctl: bottle your agent setup and run it like a recipe" />
    <meta
      property="og:description"
      content="You configure the perfect Claude Code or Codex session, then it dies with the session. teamctl lets you bottle your whole agent setup as something you can run, share, and remix like a recipe."
    />
  </head>
  <body>
    <main>
      <figure class="hero">
        <Picture
          src={heroPng}
          alt=""
          loading="eager"
          decoding="async"
          formats={['avif', 'webp']}
          fallbackFormat="jpg"
          quality={80}
        />
      </figure>

      <header class="lede">
        <h1>Bottle your agent setup. Run it, share it, remix it like a recipe.</h1>
        <p class="subline">You configure the perfect Claude Code or Codex session setup, then it dies with the session. You can't run it again, can't hand it to a teammate, can't pass it on.</p>
      </header>

      <p class="intro">
        You describe your team in YAML: who the agents are, what each one owns, and how they talk to each other. Each agent is a real Claude Code, Codex, or Gemini session with its own memory. <code>teamctl up</code> brings them up. Hand it to a teammate and they get the same team, not a screenshot of yours.
      </p>

      <p class="intro">
        I built this for myself. Experiments worth sharing, so here we are :)
      </p>

      <section class="install-section">
        <div class="install">
          <pre><code id="install-cmd">{installCmd}</code></pre>
          <button type="button" class="copy-btn" data-copy aria-label="Copy install command">
            <span class="copy-default">Copy</span>
            <span class="copy-done" hidden>Copied</span>
          </button>
        </div>
        <p class="install-note">
          Installs <code>teamctl</code> in your command line.
        </p>
      </section>

      <section class="start-team">
        <h2>Start a team</h2>
        <p>
          Then, inside your project directory:
        </p>
        <pre class="up"><code><span class="prompt">$ </span>cd /path/to/your/project</code></pre>
        <pre class="up"><code><span class="prompt">$ </span>{initCmd}</code></pre>
        <p>
          <code>init</code> opens a short conversation that surfaces the <em>domains</em> in your work and proposes a team shape. You can let it design the team with you (guided), start from a small essentials scaffold, or take an empty tree and hand-wire it yourself. By the time you're done, <code>.team/team-compose.yaml</code> is on disk and the team is running in <code>tmux</code>.
        </p>
      </section>

      <section class="extras">
        <h2>Extras on top</h2>
        <p>
          Because teamctl runs your sessions, it can hand them tools they would not have on their own. A session can call <code>compact_self</code> to compact its own context and keep going, and that is just the start:
        </p>
        <ol class="extras-list">
          {extras.map((x) => (
            <li>
              <span class="extra-emoji" aria-hidden="true">{x.emoji}</span>{' '}
              {x.href
                ? <a href={x.href}><strong>{x.title}:</strong></a>
                : <strong>{x.title}:</strong>}{' '}
              <span set:html={withCode(x.body)} />
            </li>
          ))}
        </ol>
        <p class="extras-note">
          <em>These extras are optional. They are here to help fill the gaps as you design different agent setups.</em>
        </p>
      </section>

      <section class="examples">
        <h2>Examples</h2>
        <p>
          Real teams running on teamctl. Copy any of them as a starting point.
        </p>
        <ul class="examples-list">
          {examples.map((ex) => (
            <li>
              <a class="example-link" href={ex.href}>
                <div class="example-head">
                  <span class="example-emoji" aria-hidden="true">{ex.emoji}</span>
                  <span class="example-title">{ex.title}</span>
                </div>
                <p class="example-what">{ex.what}</p>
              </a>
            </li>
          ))}
        </ul>
        <p class="examples-more">
          More under <a href="https://github.com/Alireza29675/teamctl/tree/main/examples"><code>examples/</code></a>.
        </p>
      </section>

      <section class="demo-section">
        <h2>What a team looks like</h2>
        <p>A project YAML with one manager and three workers (illustrative, not a full config):</p>
        <figure class="demo" aria-label="Example team-compose.yaml and the commands to run it">
          <div class="code-card">
            <pre class="yaml"><code set:html={yamlHtml}></code></pre>
          </div>
          <pre class="up"><code><span class="prompt">$ </span>teamctl validate    <span class="cmt"># check the YAML</span></code></pre>
          <pre class="up"><code><span class="prompt">$ </span>teamctl up          <span class="cmt"># bring the team up</span></code></pre>
          <pre class="up"><code><span class="prompt">$ </span>teamctl ui          <span class="cmt"># watch them work</span></code></pre>
          <pre class="up"><code><span class="prompt">$ </span>teamctl status      <span class="cmt"># is everyone alive?</span></code></pre>
        </figure>
        <p class="demo-note">
          <em>All of this lives in a <code>.team/</code> folder in your project, so you can read it, version it, and share it.</em>
        </p>
      </section>

      <section class="ui-section">
        <h2>Inspect your setup (<code>teamctl ui</code>)</h2>
        <p>
          A super lightweight UI, built in Rust, for inspecting your agents and their <em>actual</em> Claude Code sessions. See which agents you have, the messages they have exchanged, and work with a live session right from the UI. Each agent runs in a tmux session in the background, so when you close the UI the sessions keep working.
        </p>
        <div class="ui-shots">
          {uiShots.map((shot) => (
            <figure class="ui-shot">
              <Image src={shot.src} alt={shot.caption} loading="lazy" decoding="async" quality={80} />
              <figcaption>{shot.caption}</figcaption>
            </figure>
          ))}
        </div>
      </section>

      <section class="learn-more">
        <h2>Learn more</h2>
        <ul class="learn-list">
          <li>
            📖 <a href="/concepts/teams/">How to think about agent teams</a> for the methodology behind team design.
          </li>
          <li>
            📚 <a href="/getting-started/">Documentation</a> for full docs, concepts, and reference.
          </li>
          <li>
            🧪 <a href="/compare/">How teamctl compares</a> for the feature matrix against neighboring tools.
          </li>
        </ul>
      </section>

      <nav class="outbound" aria-label="Outbound links">
        <a href="https://github.com/Alireza29675/teamctl">Star on GitHub</a>
        <span class="sep" aria-hidden="true">·</span>
        <a href="https://github.com/Alireza29675/teamctl/tree/main/examples">Examples on GitHub</a>
      </nav>
    </main>

    <script>
      const btn = document.querySelector<HTMLButtonElement>('[data-copy]');
      const cmd = document.getElementById('install-cmd');
      if (btn && cmd) {
        btn.addEventListener('click', async () => {
          try {
            await navigator.clipboard.writeText(cmd.textContent ?? '');
            const def = btn.querySelector<HTMLElement>('.copy-default');
            const done = btn.querySelector<HTMLElement>('.copy-done');
            if (def && done) {
              def.hidden = true;
              done.hidden = false;
              setTimeout(() => {
                def.hidden = false;
                done.hidden = true;
              }, 1600);
            }
          } catch {
            /* clipboard refused: leave UI untouched */
          }
        });
      }
    </script>

    <style>
      :root {
        --bg: #0d0e10;
        --bg-soft: #14161a;
        --fg: #e9e7df;
        --fg-mute: #8a8780;
        --hairline: rgba(233, 231, 223, 0.12);
        --accent: #d6a15a;
        --serif: 'Iowan Old Style', 'Charter', 'Georgia', serif;
        --sans: ui-sans-serif, system-ui, -apple-system, 'Inter', sans-serif;
        --mono: ui-monospace, 'JetBrains Mono', 'SF Mono', Menlo, monospace;
      }
      html, body {
        background:
          radial-gradient(ellipse 80% 60% at 50% 0%, rgba(255, 240, 215, 0.025), transparent 60%),
          var(--bg);
        color: var(--fg);
        font-family: var(--sans);
        margin: 0;
        -webkit-font-smoothing: antialiased;
      }
      main {
        max-width: 50rem;
        margin: 0 auto;
        padding: 14vh 2rem 8rem;
        display: grid;
        gap: 3rem;
      }
      a { color: var(--fg); }
      a:hover { color: var(--accent); }

      /* Hero */
      .hero {
        margin: 0;
        border-radius: 10px;
        overflow: hidden;
        border: 1px solid var(--hairline);
        background: var(--bg-soft);
      }
      .hero img {
        display: block;
        width: 100%;
        height: auto;
      }

      /* Lede */
      .lede { display: grid; gap: 0.9rem; }
      h1 {
        font-family: var(--serif);
        font-weight: 400;
        font-size: clamp(2rem, 4.4vw, 3rem);
        line-height: 1.18;
        letter-spacing: -0.012em;
        margin: 0;
      }
      .subline {
        margin: 0;
        color: var(--fg-mute);
        font-size: 1.05rem;
        line-height: 1.5;
      }

      .intro {
        margin: 0;
        color: var(--fg);
        font-size: 1.02rem;
        line-height: 1.65;
      }
      .intro a {
        border-bottom: 1px solid var(--hairline);
        text-decoration: none;
      }
      .intro a:hover {
        border-color: rgba(214, 161, 90, 0.5);
      }

      h2 {
        font-family: var(--serif);
        font-weight: 400;
        font-size: 1.6rem;
        margin: 0 0 0.6rem;
        letter-spacing: -0.005em;
      }
      h2 code {
        font-family: var(--mono);
        font-size: 0.8em;
        background: rgba(214, 161, 90, 0.08);
        padding: 0.05em 0.3em;
        border-radius: 4px;
      }

      section p {
        margin: 0 0 0.9rem;
        color: var(--fg);
        font-size: 1rem;
        line-height: 1.6;
      }
      section p:last-child { margin-bottom: 0; }
      section code {
        font-family: var(--mono);
        font-size: 0.9em;
        background: rgba(214, 161, 90, 0.08);
        padding: 0.05em 0.3em;
        border-radius: 4px;
      }
      section a {
        border-bottom: 1px solid var(--hairline);
        text-decoration: none;
      }
      section a:hover {
        border-color: rgba(214, 161, 90, 0.5);
      }

      /* Install */
      .install-section { margin-top: 0; display: grid; gap: 0.6rem; }
      .install {
        position: relative;
        background: var(--bg-soft);
        border: 1px solid var(--hairline);
        border-radius: 8px;
      }
      .install pre {
        margin: 0;
        padding: 1.05rem 6rem 1.05rem 1.25rem;
        overflow-x: auto;
        font-family: var(--mono);
        font-size: 0.95rem;
        color: var(--fg);
        white-space: pre;
      }
      .install-note {
        margin: 0;
        color: var(--fg-mute);
        font-size: 0.92rem;
      }
      .copy-btn {
        position: absolute;
        right: 0.5rem;
        top: 50%;
        transform: translateY(-50%);
        background: transparent;
        color: var(--fg-mute);
        border: 1px solid var(--hairline);
        border-radius: 6px;
        padding: 0.35rem 0.8rem;
        font: inherit;
        font-size: 0.82rem;
        cursor: pointer;
        transition: color 200ms ease, border-color 200ms ease;
      }
      .copy-btn:hover, .copy-btn:focus-visible {
        color: var(--accent);
        border-color: rgba(214, 161, 90, 0.5);
        outline: none;
      }

      /* Extras */
      .extras-list {
        margin: 0.6rem 0 0.9rem;
        padding-left: 1.4rem;
        display: grid;
        gap: 0.6rem;
      }
      .extras-list li {
        color: var(--fg);
        font-size: 1rem;
        line-height: 1.55;
      }
      .extras-list strong { color: var(--fg); }
      .extras-list a { border-bottom: none; }
      .extra-emoji { margin-right: 0.15rem; }
      .extras-note {
        margin: 0;
        color: var(--fg-mute);
        font-size: 0.95rem;
      }

      /* Examples list */
      .examples-list {
        list-style: none;
        padding: 0;
        margin: 1rem 0 0.6rem;
        display: grid;
        gap: 0.6rem;
      }
      .example-link {
        display: block;
        padding: 0.9rem 1.1rem;
        border: 1px solid var(--hairline);
        border-radius: 8px;
        background: var(--bg-soft);
        text-decoration: none;
        color: var(--fg);
        transition: border-color 200ms ease, background 200ms ease;
      }
      .example-link:hover {
        border-color: rgba(214, 161, 90, 0.5);
        background: rgba(214, 161, 90, 0.04);
      }
      .example-head {
        display: flex;
        flex-wrap: wrap;
        align-items: baseline;
        gap: 0.5rem;
        margin-bottom: 0.25rem;
      }
      .example-emoji {
        font-size: 1.1rem;
      }
      .example-title {
        font-weight: 600;
        color: var(--fg);
        font-family: var(--mono);
        font-size: 0.96rem;
      }
      .example-what {
        margin: 0;
        color: var(--fg-mute);
        font-size: 0.96rem;
        line-height: 1.55;
      }
      .examples-more {
        margin: 0.6rem 0 0;
        color: var(--fg-mute);
        font-size: 0.95rem;
      }

      /* Demo: code card + $ teamctl ... */
      .demo { margin: 0.6rem 0 0; display: grid; gap: 0.35rem; }
      .demo .code-card { margin-bottom: 0.65rem; }

      .code-card {
        position: relative;
        background:
          linear-gradient(180deg, rgba(255, 245, 220, 0.018), transparent 40%),
          var(--bg-soft);
        border: 1px solid var(--hairline);
        border-radius: 10px;
        box-shadow:
          inset 0 1px 0 rgba(255, 255, 255, 0.025),
          0 1px 0 rgba(0, 0, 0, 0.4);
      }
      .yaml {
        margin: 0;
        padding: 1.5rem 1.75rem;
        overflow-x: auto;
        font-family: var(--mono);
        font-size: 0.92rem;
        line-height: 1.75;
        color: var(--fg);
        white-space: pre;
      }
      .yaml :global(.k) { color: var(--accent); }

      .up {
        margin: 0;
        padding: 0.4rem 0.25rem 0;
        font-family: var(--mono);
        font-size: 0.92rem;
        color: var(--fg-mute);
        background: transparent;
      }
      .up .prompt { color: var(--fg-mute); user-select: none; }
      .up code { color: var(--fg); }
      .up .cmt { color: var(--fg-mute); }
      .demo-note {
        margin: 0.6rem 0 0;
        color: var(--fg-mute);
        font-size: 0.95rem;
      }

      /* teamctl ui shots */
      .ui-shots {
        display: grid;
        gap: 1.5rem;
        margin: 0.6rem 0 0;
      }
      .ui-shot { margin: 0; }
      .ui-shot img {
        display: block;
        width: 100%;
        height: auto;
        border: 1px solid var(--hairline);
        border-radius: 8px;
        background: var(--bg-soft);
      }
      .ui-shot figcaption {
        margin-top: 0.5rem;
        color: var(--fg-mute);
        font-size: 0.92rem;
        font-style: italic;
      }

      /* Learn more */
      .learn-list {
        list-style: none;
        padding: 0;
        margin: 0.4rem 0 0;
        display: grid;
        gap: 0.5rem;
      }
      .learn-list li {
        color: var(--fg);
