---
import '../styles/launch.css';
import OrganizationStory from '../components/landing/OrganizationStory.astro';

const title = 'TeamCTL — Create autonomous teams of agents';
const description = 'Open-source infrastructure for agents that work together in the background. Define roles, connect agents and run anything from a personal assistant to a research team.';
const github = 'https://github.com/Alireza29675/teamctl';
const releaseSignupEndpoint = '/api/release-signup';
// Public widget identifier; keep CI builds functional without a private .env file.
const turnstileSiteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY?.trim() || '0x4AAAAAAFaBROEb6aP6oIK7';
const harnesses = [
  { name: 'Claude Code', icon: 'claude-code' },
  { name: 'Codex', icon: 'codex' },
  { name: 'OpenCode', icon: 'opencode' },
  { name: 'Gemini CLI', icon: 'gemini-cli' },
];
const heroHarnesses = harnesses.filter((harness) => harness.icon !== 'gemini-cli');
const approaches = [
  { name: 'Grok Bot', icon: 'grok-bot', href: 'https://x.ai/news/introducing-grok-bot' },
  { name: 'Dots', icon: 'dots', href: 'https://openai.com/index/introducing-dots/' },
  { name: 'Muse', icon: 'muse', href: 'https://about.fb.com/news/2026/09/introducing-muse-personal-ai-agent/' },
  { name: 'Gemini Spark', icon: 'gemini-spark', href: 'https://blog.google/innovation-and-ai/products/gemini-app/next-evolution-gemini-app/' },
];
---
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href="https://teamctl.run/" />
    <link rel="icon" href="/favicon.ico" sizes="16x16 32x32 48x48" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" sizes="any" />
    <link rel="preload" href="/fonts/manrope-regular.ttf" as="font" type="font/ttf" crossorigin />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="TeamCTL" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content="https://teamctl.run/" />
    <meta property="og:image" content="https://teamctl.run/brand/social-cover.png" />
    <meta property="og:image:alt" content="Two TeamCTL characters building a structure together. Create autonomous teams of agents." />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="https://teamctl.run/brand/social-cover.png" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="launch-nav wrap">
      <a class="brand" href="/" aria-label="TeamCTL home"><img src="/brand/teamctl-head.svg" width="44" height="44" alt="" />TeamCTL</a>
      <nav aria-label="Main navigation">
        <a href="#how-it-works">How it works</a>
        <a href="/getting-started/">Docs</a>
        <a href={github}>GitHub <span aria-hidden="true">↗</span></a>
      </nav>
    </header>

    <main id="main" class="wrap">
      <section class="launch-hero" aria-labelledby="hero-heading">
        <div class="hero-copy">
          <h1 id="hero-heading">Create autonomous<br class="wide-break" /> teams of agents.</h1>
          <div class="harness-line">
            <span class="harness-intro">And orchestrate</span>
            <ul class="harnesses" aria-label="Supported agent harnesses">
              {heroHarnesses.map((harness) => <li><a href="/concepts/runtimes/"><img src={`/harness/${harness.icon}.svg`} width="26" height="26" alt="" /><span>{harness.name}</span></a></li>)}
              <li class="harness-more"><a href="/concepts/runtimes/">and more</a></li>
            </ul>
          </div>
          <p class="hero-description">Define their roles and how they work together.<br class="wide-break" /> Run them in the background, on your own machine.</p>
          <div class="actions">
            <a class="primary" href="/getting-started/">Get started <span aria-hidden="true">↗</span></a>
            <a class="secondary" href={github}>Explore the source <span aria-hidden="true">↗</span></a>
          </div>
        </div>
        <figure class="hero-art">
          <img src="/brand/teamwork.png" width="1254" height="1254" alt="Two TeamCTL characters building one structure together from blue and cream blocks." loading="eager" decoding="async" fetchpriority="high" />
        </figure>
        <div class="hero-caption">
          <p class="caption-summary"><strong>TeamCTL will give you the building blocks</strong> to create an autonomous personal assistant, a research team, or a whole organization of agents.</p>
          <p class="caption-detail">You define the structures, roles, and how the agents are connected.</p>
          <a href="#how-it-works" class="scroll-link">See how it works <span aria-hidden="true">↓</span></a>
        </div>
      </section>

      <OrganizationStory />

      <section id="context" class="context" aria-labelledby="context-heading">
        <div class="story">
          <h2 id="context-heading">A personal assistant is one thing you can build with TeamCTL.</h2>
          <p>TeamCTL helps you build agent orchestration around your needs. Run a personal assistant in the background, or put a team of researchers to work around the clock.</p>
          <p class="origin"><a href={`${github}/releases/tag/v0.2.8`}>Released in April 2026</a>, over three months before <a href="https://x.ai/news/introducing-grok-bot">Grok Bot’s beta launch</a> and five months before <a href="https://openai.com/index/introducing-dots/">OpenAI announced Dots</a>.</p>
          <div class="timeline" aria-label="Release timeline">
            <a href={`${github}/releases/tag/v0.2.8`}><time datetime="2026-04-26">26 Apr 2026</time><strong>TeamCTL release</strong></a>
            <span class="timeline-line" aria-hidden="true"></span>
            <a href="https://x.ai/news/introducing-grok-bot"><time datetime="2026-08-11">11 Aug 2026</time><strong>Grok Bot beta launch</strong></a>
            <span class="timeline-line" aria-hidden="true"></span>
            <a href="https://openai.com/index/introducing-dots/"><time datetime="2026-09-29">29 Sep 2026</time><strong>OpenAI announces Dots</strong></a>
            <span class="timeline-line" aria-hidden="true"></span>
            <a class="timeline-next" href="#next-teamctl"><span class="timeline-date">???</span><strong>??? by TeamCTL</strong></a>
          </div>
        </div>
        <div class="comparison">
          <h3 id="comparison-heading">Where TeamCTL fits</h3>
          <div class="comparison-scroll" role="region" aria-labelledby="comparison-heading" tabindex="0">
            <table class="comparison-table" aria-labelledby="comparison-heading">
              <colgroup><col class="capability-column" /><col class="assistants-column" /><col class="orchestration-column" /></colgroup>
              <thead><tr><th scope="col">Capability</th><th scope="col"><span class="comparison-products">{approaches.map((item) => <a href={item.href}><img class="product-icon" src={`/products/${item.icon}.svg`} width="16" height="16" alt="" />{item.name}<span aria-hidden="true">↗</span></a>)}</span><span class="table-heading-note">Ready-made assistants</span></th><th scope="col"><span class="comparison-team"><img class="product-icon" src="/brand/teamctl-head.svg" width="16" height="16" alt="" />TeamCTL</span><span class="table-heading-note">Open-source orchestration layer</span></th></tr></thead>
              <tbody>
                <tr>
                  <th scope="row">Starting point</th>
                  <td>An assistant ready to work.</td>
                  <td>Building blocks for agent teams, including a personal assistant.<a class="footnote-mark" href="#assistant-definitions" aria-label="About sharing team definitions">*</a></td>
                </tr>
                <tr>
                  <th scope="row">Agent engines</th>
                  <td>A provider-managed agent stack.</td>
                  <td>Mix {harnesses.map((harness) => harness.name).join(', ')}.<a class="cell-note" href="/concepts/runtimes/#adding-a-new-runtime">Extend with custom harness adapters.</a></td>
                </tr>
                <tr>
                  <th scope="row">What you define</th>
                  <td>Your assistant’s goals, instructions and connected apps; options vary by product.</td>
                  <td>Your team’s agent roles, reporting lines, channels and tools.</td>
                </tr>
                <tr>
                  <th scope="row">Where it runs</th>
                  <td>Their cloud.</td>
                  <td>Your machine, your Mac mini, your server.</td>
                </tr>
                <tr>
                  <th scope="row">Definitions &amp; source</th>
                  <td>Configuration managed within each product.</td>
                  <td>Open source. Team definitions as code in YAML. Store, version and share with Git.</td>
                </tr>
              </tbody>
            </table>
          </div>
          <p class="comparison-footnote" id="assistant-definitions"><span class="footnote-symbol" aria-hidden="true">*</span><span>Create a personalized assistant and share its team definition, or start with someone else’s <a href={`${github}/blob/main/examples/personal-research/.team/projects/research.yaml`}>example YAML definition</a>.</span></p>
        </div>
      </section>
    </main>

    <section id="open-source" class="ownership" aria-labelledby="ownership-heading">
      <div class="wrap ownership-inner">
        <h2 id="ownership-heading">TeamCTL is <a href={github}>open source</a>, so you can:</h2>
        <ul class="ownership-freedoms" aria-label="The TeamCTL philosophy">
          <li>Switch providers freely.</li>
          <li>Own your data.</li>
          <li>Customize everything.</li>
          <li>Store team definitions in open repositories and share them with others <span class="sharing-aside">(sharing is caring).</span></li>
        </ul>
      </div>
    </section>

    <section id="next-teamctl" class="next-release" aria-labelledby="next-release-heading">
      <div class="release-stage">
        <div class="wrap next-release-inner">
          <div class="release-copy">
            <h2 id="next-release-heading">The next TeamCTL<br /> is taking shape<br /> <span>in the shadows.</span></h2>
            <p class="release-team">With a TeamCTL team helping build it.</p>
          </div>
          <div class="signup-block">
            <div class="signup-title">
              <img class="signup-character" src="/brand/teamctl-head.svg" width="52" height="52" alt="" aria-hidden="true" />
              <h3 id="signup-heading">Get notified when it’s ready.</h3>
            </div>
            <form id="release-signup" method="post" action={releaseSignupEndpoint || '/api/release-signup'} aria-labelledby="signup-heading" data-endpoint={releaseSignupEndpoint} hidden>
              <label class="signup-label" for="release-email">Email address</label>
              <div class="signup-trap" aria-hidden="true"><label for="signup-website">Website</label><input id="signup-website" name="website" type="text" tabindex="-1" autocomplete="off" /></div>
              <div class="signup-field">
                <input id="release-email" name="email" type="email" autocomplete="email" placeholder="you@example.com" maxlength="254" required aria-describedby="signup-promise" />
                <button type="submit" disabled>Notify me <span aria-hidden="true">↗</span></button>
              </div>
              <div class="signup-verification" data-sitekey={turnstileSiteKey}></div>
              <p class="signup-success" tabindex="-1" hidden><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10" /><path d="m7.5 12 3 3 6-6" /></svg><span>You’re on the list.</span></p>
              <p class="signup-promise" id="signup-promise">No spam. Just one email when the next TeamCTL is ready.</p>
              <p class="signup-status" role="status" aria-live="polite" hidden></p>
            </form>
            <noscript><p class="signup-promise">Enable JavaScript to sign up for the release notification.</p></noscript>
          </div>
        </div>
      </div>
      <aside class="creator-contact wrap" aria-labelledby="creator-heading">
        <h3 id="creator-heading">Contact the creator</h3>
        <div class="creator-profile">
          <a class="creator-identity" href="https://github.com/Alireza29675">
            <img src="/creator/alireza.jpg" width="56" height="56" loading="lazy" decoding="async" alt="" />
            <span class="creator-details"><span>Alireza Sheikholmolouki</span><small>Virgin Music, ex-Miro</small></span>
          </a>
          <nav aria-label="Creator links">
            <a href="https://github.com/Alireza29675">GitHub <span aria-hidden="true">↗</span></a>
            <a href="https://www.linkedin.com/in/alireza-sheikholmolouki/">LinkedIn <span aria-hidden="true">↗</span></a>
            <a href="https://alireza.cc/">Website <span aria-hidden="true">↗</span></a>
          </nav>
        </div>
      </aside>
    </section>

    <footer class="launch-footer wrap">
      <p>TeamCTL <span>· Open source, MIT</span></p>
      <nav aria-label="Footer"><a href="/getting-started/">Documentation</a><a href={`${github}/tree/main/examples`}>Examples</a><a href={github}>GitHub ↗</a></nav>
    </footer>
    <script>
      type TurnstileApi = {
        render(container: HTMLElement, options: Record<string, unknown>): string;
        reset(widgetId: string): void;
        remove(widgetId: string): void;
      };
      const turnstileWindow = window as Window & { turnstile?: TurnstileApi };
      const signupForm = document.querySelector<HTMLFormElement>('#release-signup');
      const signupInput = signupForm?.querySelector<HTMLInputElement>('#release-email');
      const signupButton = signupForm?.querySelector<HTMLButtonElement>('button');
      const signupStatus = signupForm?.querySelector<HTMLParagraphElement>('.signup-status');
      const signupField = signupForm?.querySelector<HTMLDivElement>('.signup-field');
      const signupSuccess = signupForm?.querySelector<HTMLParagraphElement>('.signup-success');
      const signupVerification = signupForm?.querySelector<HTMLDivElement>('.signup-verification');

      if (signupForm && signupInput && signupButton && signupStatus && signupField && signupSuccess && signupVerification) {
        let widgetId: string | undefined;
        let token = '';
        let submitting = false;
        let complete = false;
        let verificationMessage = false;
        const updateButton = () => { signupButton.disabled = submitting || complete || !token; };
        const showStatus = (message: string, verification = false) => {
          verificationMessage = verification;
          signupStatus.textContent = message;
          signupStatus.hidden = false;
        };
        const sitekey = signupVerification.dataset.sitekey;
        if (sitekey) {
          showStatus('Verifying…', true);
          const script = document.createElement('script');
          script.src = 'https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit';
          script.async = true;
          script.onload = () => {
            const api = turnstileWindow.turnstile;
            if (!api) { showStatus('Verification couldn’t load. Refresh and try again.', true); return; }
            try {
              widgetId = api.render(signupVerification, {
                sitekey, action: 'release-signup', theme: 'dark', size: 'compact', appearance: 'interaction-only',
                callback: (value: string) => {
                  token = value;
                  updateButton();
                  if (verificationMessage) { signupStatus.hidden = true; signupStatus.textContent = ''; verificationMessage = false; }
                },
                'expired-callback': () => {
                  token = '';
                  updateButton();
                  if (!complete && widgetId) api.reset(widgetId);
                },
                'error-callback': () => {
                  token = '';
                  updateButton();
                  if (!complete) showStatus('Verification couldn’t finish. Refresh and try again.', true);
                  return true;
                },
              });
            } catch {
              showStatus('Verification couldn’t load. Refresh and try again.', true);
            }
          };
          script.onerror = () => showStatus('Verification couldn’t load. Refresh and try again.', true);
          document.head.append(script);
        } else {
          showStatus('Signup is being connected. Please try again soon.');
        }

        signupForm.addEventListener('submit', async (event) => {
          event.preventDefault();
          if (submitting || complete || !signupForm.reportValidity()) return;
          if (!token) { showStatus('Please wait for verification, then try again.', true); return; }
          const endpoint = signupForm.dataset.endpoint;
          if (!endpoint) { showStatus('Signup isn’t connected yet.'); return; }

          submitting = true;
          updateButton();
          showStatus('Saving your spot…');
          try {
            const response = await fetch(endpoint, {
              method: 'POST',
              signal: AbortSignal.timeout(10000),
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ email: signupInput.value.trim(), website: new FormData(signupForm).get('website'), consentVersion: 'teamctl-next-release-v1', turnstileToken: token }),
            });
            if (response.status === 429) { showStatus('Too many attempts. Please try again shortly.'); return; }
            if (response.status === 403) { showStatus('Verification expired. Please try again.'); return; }
            if (response.status === 503) { showStatus('Signup is being connected. Please try again soon.'); return; }
            const result = await response.json();
            if (!response.ok || result.success !== true) throw new Error('Signup failed');
            complete = true;
            signupField.hidden = true;
            signupVerification.hidden = true;
            signupSuccess.hidden = false;
            signupStatus.hidden = true;
            signupStatus.textContent = '';
            signupForm.reset();
            if (widgetId) turnstileWindow.turnstile?.remove(widgetId);
            signupSuccess.focus();
          } catch {
            showStatus('Couldn’t subscribe. Please try again.');
          } finally {
            submitting = false;
            token = '';
            updateButton();
            if (!complete && widgetId) turnstileWindow.turnstile?.reset(widgetId);
          }
        });
        signupForm.hidden = false;
      }
    </script>
  </body>
</html>
