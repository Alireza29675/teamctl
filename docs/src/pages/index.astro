---
import { Image } from 'astro:assets';
import Footer from '../components/landing/Footer.astro';
import '../styles/landing.css';
import uiSplash from '../../assets/ui/splash.png';
import uiControlRoom from '../../assets/ui/control-room.png';
import uiAgentDetail from '../../assets/ui/agent-detail.png';
import uiTypeIntoPane from '../../assets/ui/type-into-pane.png';

const title = 'TeamCTL — Create autonomous teams of agents.';
const description = 'An open-source platform for defining how agents work together. Choose their roles, structure and conversations. Run the team in the background and share its setup.';
const installCmd = 'curl -fsSL https://teamctl.run/install | sh';
const yaml = `version: 2
project:
  id: my-team

channels:
  - name: work
    members: [lead, builder]

managers:
  lead:
    runtime: claude-code
    role_prompt: roles/lead.md

workers:
  builder:
    runtime: codex
    role_prompt: roles/builder.md
    reports_to: lead`;

const expandedYaml = `version: 2
project:
  id: project-team

channels:
  - name: work
    members: [lead, builder, reviewer]
  - name: review
    members: [builder, reviewer]

managers:
  lead:
    display_name: Team lead
    runtime: claude-code
    role_prompt:
      - roles/_base.md
      - roles/lead.md

workers:
  builder:
    display_name: Builder
    runtime: codex
    role_prompt:
      - roles/_base.md
      - roles/builder.md
    reports_to: lead
  reviewer:
    display_name: Reviewer
    runtime: opencode
    role_prompt:
      - roles/_base.md
      - roles/reviewer.md
    reports_to: lead`;

const examples = [
  { name: 'Product team', slug: 'product-team', description: 'A product manager, engineering lead and builders with defined responsibilities.' },
  { name: 'Open-source maintainer', slug: 'oss-maintainer', description: 'Triage, implementation, documentation and release proposals.' },
  { name: 'Prototype team', slug: 'autonomous-prototyper', description: 'Research ideas, evaluate them and build experiments.' },
  { name: 'Personal research', slug: 'personal-research', description: 'Explore interests, collect sources and discuss findings.' },
  { name: 'Job finder', slug: 'job-finder', description: 'Research opportunities and draft application materials for review.' },
];
const uiShots = [
  { src: uiAgentDetail, caption: 'Inspect the messages exchanged by an agent.' },
  { src: uiTypeIntoPane, caption: 'Open a live tmux session with Ctrl+E and interact directly.' },
  { src: uiSplash, caption: 'The terminal UI starts from one command: teamctl ui.' },
];
---
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href="https://teamctl.run/" />
    <link rel="icon" href="/favicon.ico" sizes="16x16 32x32 48x48" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" sizes="any" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="TeamCTL" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content="https://teamctl.run/" />
    <meta property="og:image" content="https://teamctl.run/brand/social-cover.png" />
    <meta property="og:image:alt" content="Two TeamCTL characters building a structure together. Create autonomous teams of agents." />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="https://teamctl.run/brand/social-cover.png" />
  </head>
  <body class="landing">
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-nav">
      <a class="brand-link" href="/" aria-label="TeamCTL home"><img src="/brand/teamctl-head.svg" alt="" width="44" height="44" />TeamCTL</a>
      <nav class="nav-links" aria-label="Main navigation">
        <a href="/getting-started/">Docs</a>
        <a class="nav-examples" href="https://github.com/Alireza29675/teamctl/tree/main/examples">Examples</a>
        <a class="nav-github" href="https://github.com/Alireza29675/teamctl">GitHub ↗</a>
      </nav>
    </header>
    <main id="main" class="page-width">
      <section class="hero-section" aria-labelledby="hero-heading">
        <div class="hero-copy">
          <p class="eyebrow">Open-source agent platform</p>
          <h1 id="hero-heading">Create autonomous teams of agents.</h1>
          <ul class="harness-logos" aria-label="Supported agent harnesses">
            <li><a href="/concepts/runtimes/"><img src="/harness/claude-code.svg" width="26" height="26" alt="" /><span>Claude Code</span></a></li>
            <li><a href="/concepts/runtimes/"><img src="/harness/codex.svg" width="26" height="26" alt="" /><span>Codex</span></a></li>
            <li><a href="/concepts/runtimes/"><img src="/harness/opencode.svg" width="26" height="26" alt="" /><span>OpenCode</span></a></li>
            <li><a href="/concepts/runtimes/"><img src="/harness/gemini-cli.svg" width="26" height="26" alt="" /><span>Gemini CLI</span></a></li>
          </ul>
          <p class="hero-description">Define roles, team structure and conversations. Run the agents in the background. Share the configuration and role files.</p>
          <div class="actions">
            <a class="button" href="#setup">Set up your first team</a>
            <a class="text-link" href="/concepts/teams/">Explore team design</a>
          </div>
        </div>
        <figure class="hero-art"><img src="/brand/teamwork.png" width="1254" height="1254" alt="Two TeamCTL characters building a structure together from blue and Chalk blocks." loading="eager" decoding="async" fetchpriority="high" /></figure>
      </section>

      <section class="content-section" aria-labelledby="shapes-heading">
        <div class="section-intro">
          <h2 id="shapes-heading">Team structures.</h2>
          <p>Configure two agents to research a question, a team with leads and specialists, or multiple project rosters.</p>
        </div>
        <div class="team-shapes">
          <article class="team-shape">
            <span class="shape-number">01 / PEERS</span>
            <h3>Research partners</h3>
            <p>Two researchers exchange questions, compare sources and review each other’s conclusions.</p>
            <div class="shape-roles">researcher ↔ researcher</div>
          </article>
          <article class="team-shape">
            <span class="shape-number">02 / PROJECT</span>
            <h3>A project team</h3>
            <p>A lead coordinates builders and reviewers through shared channels.</p>
            <div class="shape-roles">lead → builder + reviewer</div>
          </article>
          <article class="team-shape">
            <span class="shape-number">03 / ORGANIZATION</span>
            <h3>Multiple project teams</h3>
            <p>Separate project rosters with shared role files and their own channels.</p>
            <div class="shape-roles">shared roles · separate project rosters</div>
          </article>
        </div>
      </section>

      <section class="content-section" aria-labelledby="background-heading">
        <div class="split-section">
          <div class="section-copy">
            <p class="eyebrow">Background work</p>
            <h2 id="background-heading">Run agents in the background.</h2>
            <p>Agents exchange messages and work according to their roles. Their sessions keep running when you close the dashboard.</p>
            <p>Use the terminal UI to inspect messages or open an agent’s session.</p>
            <a class="text-link" href="/concepts/interfaces/">How you follow the work</a>
            <p class="small-note">Requires a running host, active sessions and provider access. A reboot stops the live processes.</p>
          </div>
          <div>
            <div class="terminal">
              <div class="terminal-title">Your project / terminal</div>
              <pre><code>teamctl up       <span class="cmt"># start the agents</span>
teamctl ui       <span class="cmt"># follow their work</span>
teamctl status   <span class="cmt"># inspect the team</span>
teamctl down     <span class="cmt"># stop the sessions</span></code></pre>
            </div>
            <figure class="ui-shot">
              <Image src={uiControlRoom} alt="TeamCTL terminal control room showing teams, live sessions and messages." loading="lazy" decoding="async" quality={80} />
              <figcaption>Agent sessions and messages in teamctl ui.</figcaption>
            </figure>
            <details class="details-panel">
              <summary>See more of the terminal UI</summary>
              <div class="shot-gallery">
                {uiShots.map((shot) => <figure class="ui-shot"><Image src={shot.src} alt={shot.caption} loading="lazy" decoding="async" quality={80} /><figcaption>{shot.caption}</figcaption></figure>)}
              </div>
            </details>
          </div>
        </div>
      </section>

      <section class="content-section" aria-labelledby="definition-heading">
        <div class="split-section">
          <div class="section-copy">
            <p class="eyebrow">Team configuration</p>
            <h2 id="definition-heading">Define roles and communication.</h2>
            <p>Roles are Markdown files. YAML specifies the agents, runtimes and channels. Both live in <code>.team/</code> and can be versioned and shared.</p>
            <p>This example connects a Claude Code lead and a Codex builder through one channel.</p>
            <a class="text-link" href="/reference/team-compose-yaml/">Read the configuration reference</a>
            <p class="small-note">Share configuration and role files. Each person supplies their own accounts; keep credentials and runtime state out of the shared files.</p>
          </div>
          <div>
            <div class="terminal">
              <div class="terminal-title">.team/projects/my-team.yaml / roster excerpt</div>
              <pre><code>{yaml}</code></pre>
            </div>
            <p class="small-note" style="margin-top: 1rem;">Illustrative project roster. Use a generated team folder and add the referenced role files.</p>
            <details class="details-panel">
              <summary>Expand to a lead, builder and reviewer</summary>
              <p>Add a reviewer, a review channel and shared instructions. This is an illustrative roster; supply the referenced role files and validate your configuration.</p>
              <div class="terminal"><div class="terminal-title">.team/projects/project-team.yaml / roster excerpt</div><pre><code>{expandedYaml}</code></pre></div>
              <a class="text-link" href="https://github.com/Alireza29675/teamctl/tree/main/examples/product-team">Explore a complete product-team example</a>
            </details>
          </div>
        </div>
      </section>

      <section id="setup" class="content-section setup-section" aria-labelledby="setup-heading">
        <div class="section-copy">
          <p class="eyebrow">Get started</p>
          <h2 id="setup-heading">Set up your first team.</h2>
          <p>You’ll need macOS or Linux, <code>tmux</code>, <code>git</code>, and the agent runtimes you want to use, installed and signed in.</p>
          <p>The picker defaults to Ideate & Build, a Claude Code starter. Choose Guided for conversational setup; it requires Claude Code and the TeamCTL plugin. Edit the roster to mix runtimes.</p>
          <a class="text-link" href="/getting-started/">Follow the setup guide</a>
          <p class="small-note">TeamCTL is open source. Agent usage follows your providers’ plans and limits and may still cost money.</p>
        </div>
        <div class="setup-flow">
          <div class="setup-step">
            <h3><span>1</span>Install TeamCTL</h3>
            <div class="install-command">
              <pre><code id="install-cmd">{installCmd}</code></pre>
              <button type="button" class="copy-button" data-copy aria-label="Copy install command">Copy command</button>
            </div>
            <p class="small-note">Make sure <code>~/.local/bin</code> is on your PATH.</p>
          </div>
          <div class="setup-step">
            <h3><span>2</span>Define it inside your project</h3>
            <div class="terminal"><pre><code>cd /path/to/your/project
teamctl init
teamctl validate</code></pre></div>
            <p class="small-note"><code>init</code> creates the team files. Choose a starter, review the roles and runtimes, and configure the interfaces it needs.</p>
          </div>
          <div class="setup-step">
            <h3><span>3</span>Start the agents</h3>
            <div class="terminal"><pre><code>teamctl up
teamctl ui</code></pre></div>
            <p class="small-note">Your instructions and runtime permissions shape what agents can do. Configure explicit approval requests for decisions that need your input.</p>
          </div>
        </div>
      </section>

      <section class="content-section" aria-labelledby="examples-heading">
        <div class="section-intro">
          <h2 id="examples-heading">Example team definitions.</h2>
          <p>Inspect the configuration and role files, then adapt them to your work.</p>
          <a class="text-link" href="https://github.com/Alireza29675/teamctl/tree/main/examples">Browse the examples</a>
        </div>
        <details class="details-panel">
          <summary>Explore five example teams</summary>
          <ul class="example-links">
            {examples.map((example) => <li><a href={`https://github.com/Alireza29675/teamctl/tree/main/examples/${example.slug}`}>{example.name} ↗</a><p>{example.description}</p></li>)}
          </ul>
        </details>
      </section>

    </main>
    <Footer />
    <script>
      const button = document.querySelector<HTMLButtonElement>('[data-copy]');
      const command = document.getElementById('install-cmd');
      if (button && command) {
        button.addEventListener('click', async () => {
          try {
            await navigator.clipboard.writeText(command.textContent ?? '');
            button.textContent = 'Copied';
            window.setTimeout(() => { button.textContent = 'Copy command'; }, 1600);
          } catch {
            button.textContent = 'Select the command to copy';
          }
        });
      }
    </script>
  </body>
</html>
