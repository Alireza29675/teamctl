  /* Touch layouts use ordinary page flow at every browser-chrome height.
     The full YAML stays in the page; only long lines scroll sideways. */
  @media (max-width: 760px), (pointer: coarse) {
    .organization-story[data-enhanced] { height: auto; }
    [data-enhanced] .story-pin { position: relative; height: auto; padding-block: 2rem; }
