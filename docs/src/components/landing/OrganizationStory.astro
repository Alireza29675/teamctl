<script is:inline define:vars={{ steps }}>
  for (const root of document.querySelectorAll('[data-organization-story]')) {
    if (!(root instanceof HTMLElement) || root.dataset.enhanced) continue;
    const buttons = Array.from(root.querySelectorAll('[data-story-step]'));
    const heading = root.querySelector('[data-stage-heading]');
    const description = root.querySelector('[data-stage-description]');
    const graphState = root.querySelector('[data-graph-state]');
    const announcement = root.querySelector('[data-stage-announcement]');
    const room = root.querySelector('.control-room-panel');
    const organization = root.querySelector('.organization-panel');
    const configuration = root.querySelector('.configuration-panel');
    const pin = root.querySelector('.story-pin');
    const shortViewport = window.matchMedia('(max-height: 700px)');
    const narrowViewport = window.matchMedia('(max-width: 760px)');
    const touchViewport = window.matchMedia('(pointer: coarse)');
    let activeIndex = -1;
    let frame = 0;

    function isScrollDriven() {
      return !shortViewport.matches && !narrowViewport.matches && !touchViewport.matches;
    }

    function scrollTravel(bounds) {
      // Match the CSS pin height instead of the mobile browser's changing chrome.
      return Math.max(1, bounds.height - (pin?.getBoundingClientRect().height ?? window.innerHeight));
    }

    function syncPanelAccessibility(index) {
      const stage = steps[index].id;
      const organizationVisible = stage === 'up' || stage === 'message';
      const configurationVisible = !narrowViewport.matches || stage === 'config';
      if (graphState) graphState.textContent = {
        config: 'Team configuration',
        up: 'Background sessions',
        message: 'Telegram connected',
        ui: 'Background sessions',
      }[stage];
      for (const [panel, visible] of [[organization, organizationVisible], [configuration, configurationVisible], [room, stage === 'ui']]) {
        if (!(panel instanceof HTMLElement)) continue;
        panel.inert = !visible;
        panel.setAttribute('aria-hidden', String(!visible));
      }
    }

    function showStage(index, announce = false) {
      if (index === activeIndex) {
        syncPanelAccessibility(index);
        return;
      }
      activeIndex = index;
      const step = steps[index];
      root.dataset.stage = step.id;
      if (heading) heading.textContent = step.heading;
      if (description) description.textContent = step.detail;
      for (const button of buttons) button.setAttribute('aria-pressed', String(button.dataset.storyStep === step.id));
      if (announce && announcement) announcement.textContent = `${step.label}. ${step.heading} ${step.detail}`;
      syncPanelAccessibility(index);
    }

    function updateFromScroll() {
      frame = 0;
      syncPanelAccessibility(Math.max(0, activeIndex));
      if (!isScrollDriven()) return;
      const bounds = root.getBoundingClientRect();
      const travel = scrollTravel(bounds);
      const progress = Math.max(0, Math.min(1, -bounds.top / travel));
      showStage(Math.min(steps.length - 1, Math.floor(progress * steps.length)));
    }

    function queueScrollUpdate() {
      if (!frame) frame = window.requestAnimationFrame(updateFromScroll);
    }

    root.dataset.enhanced = 'true';
    showStage(0);
    for (let index = 0; index < buttons.length; index += 1) {
      buttons[index].addEventListener('click', () => {
        showStage(index, true);
        if (!isScrollDriven()) return;
        const bounds = root.getBoundingClientRect();
        const travel = scrollTravel(bounds);
        const target = window.scrollY + bounds.top + travel * ((index + .5) / steps.length);
        window.scrollTo({ top: target, behavior: 'instant' });
      });
    }
    window.addEventListener('scroll', queueScrollUpdate, { passive: true });
    window.addEventListener('resize', () => {
      if (!frame) frame = window.requestAnimationFrame(updateFromScroll);
    }, { passive: true });
    touchViewport.addEventListener('change', queueScrollUpdate);
    updateFromScroll();
  }
</script>
