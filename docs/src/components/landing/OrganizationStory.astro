    [data-enhanced]:is([data-stage='up'], [data-stage='message'], [data-stage='ui']) .organization-panel { opacity: 1; }
    [data-enhanced]:is([data-stage='up'], [data-stage='message'], [data-stage='ui']) .configuration-panel { opacity: 0; pointer-events: none; transform: translateY(-1.5rem); }
