    .packet-4, .packet-6 { offset-distance: 72%; }
    .packet-5 { offset-distance: 80%; }
    .packet-human-1, .packet-human-3 { offset-distance: 40%; }
    .packet-human-2, .packet-human-4 { offset-distance: 65%; }
