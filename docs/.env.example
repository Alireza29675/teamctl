# Server-only. Use a Resend key that can manage contacts; never prefix it with PUBLIC_.
RESEND_API_KEY=
RESEND_SEGMENT_ID=e9a7afc4-5258-447c-ab1b-797c63e29073

# Public widget key is embedded in the browser bundle; the secret is server-only.
PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=

# Production Pages also requires the SIGNUP_REPLAY_DB D1 binding and
# docs/server/signup-replay.sql schema. Never replace it with per-isolate memory.
# The loopback-only Vite dev bridge supplies a bounded local replay store.

# Local end-to-end testing needs a widget permitting the local hostname.
# Cloudflare's dummy tokens do not include the required hostname/action;
# they can exercise widget UI, but this handler deliberately rejects them.
# https://developers.cloudflare.com/turnstile/troubleshooting/testing/
