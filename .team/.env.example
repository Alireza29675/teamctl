# teamctl-core team env vars.
#
# This is the team that develops teamctl on teamctl. Each
# user-facing agent has its own 1:1 Telegram bot per ADR 0005;
# the values below are populated by `teamctl bot setup`, which
# walks BotFather → token → /start → chat id and writes them in
# place. You shouldn't need to fill this file by hand — the
# wizard handles it. The example exists so a fresh clone can
# inspect which variables exist and what each routes to.
#
# Only one team should bind to a given bot token at a time —
# otherwise Telegram long-poll fights cause dropped messages.
#
# To wire it up:
#
#     cp .team/.env.example .team/.env       # optional; the wizard
#                                            # creates .env if missing
#     teamctl bot setup                      # walks every agent
#
# Or scope to one agent:
#
#     teamctl bot setup teamctl:sage

# Bot for teamctl:sage — co-thinker, the funnel between idea and ticket.
TEAMCTL_TG_SAGE_TOKEN=
TEAMCTL_TG_SAGE_CHATS=

# Bot for teamctl:hugo — project manager, routes ready-to-pick issues to engineers.
TEAMCTL_TG_HUGO_TOKEN=
TEAMCTL_TG_HUGO_CHATS=

# Bot for teamctl:ada — product engineer (methodical, precise).
TEAMCTL_TG_ADA_TOKEN=
TEAMCTL_TG_ADA_CHATS=

# Bot for teamctl:kian — product engineer (quiet, deep, security/regression eye).
TEAMCTL_TG_KIAN_TOKEN=
TEAMCTL_TG_KIAN_CHATS=

# Bot for teamctl:neda — technical writer & external voice (docs, README, website, positioning).
TEAMCTL_TG_NEDA_TOKEN=
TEAMCTL_TG_NEDA_CHATS=

# Bot for teamctl-ops:otto — operations manager for the dev team itself.
# Lives in a separate project so `teamctl restart teamctl` doesn't cycle it.
TEAMCTL_TG_OTTO_TOKEN=
TEAMCTL_TG_OTTO_CHATS=
