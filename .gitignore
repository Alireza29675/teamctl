# Rust
/target
**/*.rs.bk
Cargo.lock.bak

# Editors
.vscode/
.idea/
*.swp
.DS_Store

# teamctl runtime state (never committed)
/state/
/examples/*/state/

# Local git worktrees (CLAUDE.md mandates they live here; never committed)
/.worktrees/

# Local secrets (never committed)
.env
**/.env

# Docs build
/docs/dist/
/docs/.astro/
/docs/node_modules/

# Development fixtures and private personal notes
/work/
/workspace/*
!/workspace/README.md
/examples/personal-agent/workspace/*
!/examples/personal-agent/workspace/README.md
